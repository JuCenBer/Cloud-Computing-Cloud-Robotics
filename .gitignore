# ==============================================================================
# Docker & Contenedores
# ==============================================================================
.docker/
docker-compose.override.yml
docker-compose.*.local.yml

# Variables de entorno y secretos
.env
.env.local
.env.*.local
!.env.example

# Datos y dependencias generadas en contenedores (Node-RED, Node.js)
**/node_modules/
**/.npm/
**/.config.*.backup
**/.config.runtime.json.backup
**/.config.users.json.backup
**/.config.nodes.json.backup
*.tar.gz
backup_nodered.tar.gz

# ==============================================================================
# WSL (Windows Subsystem for Linux) & Windows Artifacts
# ==============================================================================
# Windows Zone Identifier files (metadatos de descarga NTFS en WSL)
*:Zone.Identifier
*Zone.Identifier

# Archivos de sistema y miniaturas de Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Archivos de configuración local de WSL
.wslconfig
wsl.conf

# ==============================================================================
# Binarios, Ejecutables y Logs de SimuPi
# ==============================================================================
# Binario descargado de SimuPi
**/simupi/simupi
**/bin/simupi-*
*.log
simupi.log
*.tmp
*.tmp.*

# ==============================================================================
# Editores & IDEs
# ==============================================================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# Archivos temporales de Linux / Unix
*~
*.swp
*.swo
.DS_Store
