        "func": "const auto = msg.payload === true || msg.payload === 'true';\nflow.set('modo', auto ? 'AUTO' : 'MANUAL');\n// Al volver a AUTO se olvida el estado para que la histéresis re-evalúe con la próxima lectura.\nif (auto) flow.set('luces', null);\n// El switch de luces solo se puede usar en modo MANUAL.\nreturn { enabled: !auto };",
