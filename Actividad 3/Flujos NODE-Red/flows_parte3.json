    {
        "id": "ve0000000000000f",
        "type": "function",
        "z": "89a908a1803bbf6a",
        "name": "Histéresis luces (<40 ON, >45 OFF)",
        "x": 420,
        "y": 480,
        "wires": [
            [
                "ve00000000000017",
                "ve00000000000016",
                "ve00000000000018"
            ]
        ],
        "func": "// Solo actúa en modo AUTOMÁTICO y solo publica cuando el estado cambia.\nif (flow.get('modo') !== 'AUTO') return null;\nconst luz = Number(msg.payload);\nif (isNaN(luz)) return null;\nconst actual = flow.get('luces');\nlet nuevo = actual;\nif (luz < 40) nuevo = 1;\nelse if (luz > 45) nuevo = 0;\nelse if (actual !== 0 && actual !== 1) nuevo = 0; // banda muerta (40-45) sin estado previo\nif (nuevo === actual) return null;\nflow.set('luces', nuevo);\nnode.status({ fill: nuevo ? 'yellow' : 'grey', shape: 'dot', text: `luz ${luz.toFixed(1)}% → luces ${nuevo ? 'ON' : 'OFF'}` });\nreturn { payload: String(nuevo) };",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "g": "ve00000000000021"
    },
    {
        "id": "ve00000000000010",
        "type": "function",
        "z": "89a908a1803bbf6a",
        "name": "Alarma de velocidad (>80 km/h)",
        "x": 420,
        "y": 560,
        "wires": [
            [
                "ve00000000000011"
            ],
            [
                "ve00000000000012"
            ]
        ],
        "func": "const v = Number(msg.payload);\nif (isNaN(v)) return null;\nconst activa = v > 80;\nconst previa = flow.get('alarma') === true;\nflow.set('alarma', activa);\nconst estado = { payload: activa ? `VELOCIDAD EXCESIVA (${v.toFixed(1)} km/h)` : 'Normal' };\n// La notificación emergente solo se muestra al activarse la alarma.\nconst aviso = (activa && !previa) ? { payload: `Alarma: la velocidad (${v.toFixed(1)} km/h) supera los 80 km/h` } : null;\nnode.status({ fill: activa ? 'red' : 'green', shape: 'dot', text: activa ? 'ALARMA' : 'normal' });\nreturn [estado, aviso];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "g": "ve00000000000021"
    },
